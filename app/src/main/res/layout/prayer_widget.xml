<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="match_parent"
    android:orientation="vertical" android:gravity="center_vertical"
    android:background="#0D271E" android:padding="16dp">
    <TextView android:id="@+id/widget_title" android:layout_width="match_parent"
        android:layout_height="wrap_content" android:text="☪ EZAN VAKTİM PRO"
        android:textColor="#D7B56D" android:textStyle="bold" android:textSize="16sp"/>
    <TextView android:id="@+id/widget_location" android:layout_width="match_parent"
        android:layout_height="wrap_content" android:text="Konum" android:textColor="#FFFFFF"
        android:textSize="12sp" android:layout_marginTop="5dp"/>
    <TextView android:id="@+id/widget_next" android:layout_width="match_parent"
        android:layout_height="wrap_content" android:text="Vakit bilgisi yükleniyor"
        android:textColor="#D7B56D" android:textSize="19sp" android:textStyle="bold"
        android:layout_marginTop="8dp"/>
    <TextView android:id="@+id/widget_detail" android:layout_width="match_parent"
        android:layout_height="wrap_content" android:text="Açmak için dokunun"
        android:textColor="#FFFFFF" android:textSize="12sp" android:layout_marginTop="4dp"/>
</LinearLayout>